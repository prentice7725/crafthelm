{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crafthelm.local/schemas/human-decision.schema.json",
  "title": "CraftHelm Human Acceptance Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "contract_sha256",
    "report_sha256",
    "evidence_manifest_sha256",
    "target_snapshot_digest",
    "decision",
    "actor",
    "recorded_at",
    "rationale",
    "accepted_risks",
    "verification_type"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "0.2" },
    "run_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "contract_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "report_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidence_manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "target_snapshot_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decision": {
      "type": "string",
      "enum": ["accepted", "changes_requested", "rejected", "verification_requested"]
    },
    "actor": { "type": "string", "minLength": 1 },
    "recorded_at": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "accepted_risks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "related_requirements": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "repro_conditions": {
      "type": "string"
    },
    "verification_type": {
      "type": "string",
      "const": "local_explicit_input_not_identity_verified"
    }
  }
}
