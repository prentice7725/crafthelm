{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crafthelm.local/schemas/human-decision.schema.json",
  "title": "CraftHelm Human Acceptance Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "contract_sha256",
    "report_sha256",
    "evidence_manifest_sha256",
    "target_snapshot_digest",
    "decision",
    "actor",
    "recorded_at",
    "rationale",
    "accepted_risks",
    "verification_type"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "0.2" },
    "run_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "contract_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "report_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidence_manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "target_snapshot_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decision": {
      "type": "string",
      "enum": ["accepted", "changes_requested", "rejected", "verification_requested"]
    },
    "actor": { "type": "string", "minLength": 1 },
    "recorded_at": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "accepted_risks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "related_requirements": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "repro_conditions": {
      "type": "string"
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_ids"],
      "properties": {
        "run_ids": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "verification_type": {
      "type": "string",
      "enum": [
        "local_explicit_input_not_identity_verified",
        "local_tty_confirmed_not_identity_verified",
        "local_review_page_not_identity_verified",
        "signed_ed25519"
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "public_key_pem", "public_key_fingerprint", "value"],
      "properties": {
        "alg": { "type": "string", "const": "ed25519" },
        "public_key_pem": { "type": "string", "minLength": 1 },
        "public_key_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "value": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "verification_type": { "const": "signed_ed25519" } },
        "required": ["verification_type"]
      },
      "then": { "required": ["signature"] },
      "else": { "not": { "required": ["signature"] } }
    }
  ]
}
