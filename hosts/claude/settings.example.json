{
  "host": "claude",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Bash(node scripts/*)",
      "Bash(npm test*)",
      "Bash(git status*)",
      "Bash(git diff*)"
    ],
    "ask": [
      "Bash(*contract.mjs approve*)",
      "Bash(*crafthelm.mjs contract approve*)",
      "Bash(*crafthelm contract approve*)",
      "Bash(*--approve-contract*)",
      "Bash(*checkpoint.mjs approve-stage*)",
      "Bash(*crafthelm.mjs checkpoint approve-stage*)",
      "Bash(*crafthelm checkpoint approve-stage*)",
      "Bash(*checkpoint.mjs close*)",
      "Bash(*crafthelm.mjs checkpoint close*)",
      "Bash(*crafthelm checkpoint close*)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(rm -rf*)",
      "Bash(*approval.mjs record*)",
      "Bash(*crafthelm.mjs approve record*)",
      "Bash(*crafthelm approve record*)",
      "Bash(*approval.mjs batch*)",
      "Bash(*crafthelm.mjs approve batch*)",
      "Bash(*crafthelm approve batch*)",
      "Bash(*approval.mjs keygen*)",
      "Bash(*crafthelm.mjs approve keygen*)",
      "Bash(*crafthelm approve keygen*)"
    ]
  },
  "crafthelm": {
    "require_kouetsu": true,
    "protect_base_ref": true,
    "allow_cross_provider_fallback": false
  }
}
