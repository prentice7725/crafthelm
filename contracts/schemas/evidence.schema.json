{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crafthelm.local/schemas/evidence.schema.json",
  "title": "CraftHelm Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "contract_sha256",
    "baseline_git_head",
    "final_tree_hash",
    "target_snapshot_digest",
    "skill_lock_sha256",
    "verification_stamp_file",
    "verification_level",
    "checks",
    "reliability_checks",
    "review",
    "scope",
    "technical_status",
    "human_review"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["0.1", "0.2", "0.3"] },
    "run_id": { "type": "string", "minLength": 1 },
    "contract_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "baseline_git_head": { "type": "string", "minLength": 1 },
    "final_tree_hash": { "type": "string", "minLength": 1 },
    "target_snapshot_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "skill_lock_sha256": { "type": "string", "pattern": "^([a-f0-9]{64}|none)$" },
    "verification_stamp_file": { "type": "string", "minLength": 1 },
    "verification_level": { "type": "string", "enum": ["none", "partial", "verified"] },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "requirement": { "type": "string" },
          "kind": { "type": "string", "enum": ["fast", "unit", "test", "e2e", "property", "differential", "manual"] },
          "command": { "type": "string" },
          "exit_code": { "type": ["integer", "null"] },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "UNVERIFIED", "NOT_APPLICABLE", "SKIPPED_UNIMPACTED"] },
          "reason": { "type": "string" },
          "selection_reason": { "type": "string" },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "timeout_ms": { "type": "integer", "minimum": 1 },
          "timed_out": { "type": "boolean" },
          "started_at": { "type": "string", "minLength": 1 },
          "stdout_file": { "type": "string" },
          "stderr_file": { "type": "string" },
          "stdout_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "stderr_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "redactions": { "type": "integer", "minimum": 0 },
          "counterexample_file": { "type": "string" },
          "seed": { "type": ["string", "number", "null"] },
          "diff_report_file": { "type": "string" }
        }
      }
    },
    "reliability_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "triggered", "policy_mode", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "triggered": { "type": "boolean" },
          "non_trigger_reason": { "type": "string" },
          "policy_mode": { "type": "string", "enum": ["off", "observe", "enforce"] },
          "severity": { "type": "string", "enum": ["must_fix", "should_fix", "nit"] },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "SKIPPED", "OBSERVED_FAIL", "BLOCKED"] },
          "evidence_file": { "type": "string" }
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["PASS", "FINDINGS", "UNVERIFIED", "STALE", "NOT_RUN"] },
        "findings_file": { "type": ["string", "null"] },
        "target_snapshot_digest": { "type": ["string", "null"] },
        "independent_cross_model": { "type": "boolean" }
      }
    },
    "scope": {
      "type": "object",
      "required": ["status", "diff_file", "changed_files", "out_of_scope_files", "protected_violations"],
      "properties": {
        "status": { "type": "string", "enum": ["PASS", "FAIL"] },
        "diff_file": { "type": "string", "minLength": 1 },
        "changed_files": { "type": "array", "items": { "type": "string" } },
        "changed_file_hashes": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^([a-f0-9]{64}|DELETED)$" } },
        "out_of_scope_files": { "type": "array", "items": { "type": "string" } },
        "protected_violations": { "type": "array", "items": { "type": "string" } },
        "policy_tamper_detected": { "type": "boolean" }
      }
    },
    "technical_status": {
      "type": "string",
      "enum": ["VERIFIED", "PARTIAL", "FAILED", "BLOCKED", "STALE"]
    },
    "evidence_strength": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "signals", "changed_source_files", "reaching_tests"],
      "properties": {
        "level": { "type": "string", "enum": ["strong", "moderate", "weak", "not_applicable"] },
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "weight", "detail", "human_check"],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "NO_EXECUTED_PASSING_CHECK",
                  "NO_TEST_REACHES_CHANGE",
                  "SINGLE_GENERIC_CHECK",
                  "NO_TEST_CHANGED",
                  "MUTANTS_SURVIVED",
                  "IMPACT_INCONCLUSIVE",
                  "TEST_FILE_DELETED",
                  "TEST_SKIP_ADDED",
                  "ASSERTIONS_REMOVED"
                ]
              },
              "weight": { "type": "string", "enum": ["weak", "moderate"] },
              "detail": { "type": "string", "minLength": 1 },
              "human_check": { "type": "string", "minLength": 1 },
              "refs": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "changed_source_files": { "type": "array", "items": { "type": "string" } },
        "reaching_tests": { "type": "array", "items": { "type": "string" } }
      }
    },
    "process_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "e2e_exempted", "violations", "limits", "observed"],
      "properties": {
        "profile": { "type": "string", "enum": ["full", "lite"] },
        "limits_enforced": { "type": "boolean" },
        "e2e_exempted": { "type": "boolean" },
        "violations": { "type": "array", "items": { "type": "string" } },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_changed_source_files", "max_added_lines"],
          "properties": {
            "max_changed_source_files": { "type": "integer", "minimum": 1 },
            "max_added_lines": { "type": "integer", "minimum": 1 }
          }
        },
        "observed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["change_kind", "changed_source_files", "added_lines", "evidence_strength"],
          "properties": {
            "change_kind": { "type": "string" },
            "changed_source_files": { "type": "integer", "minimum": 0 },
            "added_lines": { "type": "integer", "minimum": 0 },
            "evidence_strength": { "type": "string" }
          }
        }
      }
    },
    "probe_recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "file", "problem"],
      "properties": {
        "status": { "type": "string", "enum": ["RESTORED", "REJECTED"] },
        "file": { "type": ["string", "null"] },
        "restored_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "problem": { "type": ["string", "null"], "enum": ["JOURNAL_CORRUPT", "JOURNAL_PATH_REJECTED", "FILE_CHANGED_SINCE_PROBE", null] },
        "detail": { "type": ["string", "null"] }
      }
    },
    "mutation_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "total", "killed", "survived", "score", "evidence_file"],
      "properties": {
        "status": { "type": "string", "enum": ["NOT_REQUESTED", "PROBED", "NO_MUTABLE_LINES", "SKIPPED"] },
        "total": { "type": "integer", "minimum": 0 },
        "killed": { "type": "integer", "minimum": 0 },
        "survived": { "type": "integer", "minimum": 0 },
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "evidence_file": { "type": ["string", "null"] }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "record_count", "observed_count", "self_reported_count", "roles", "tiers", "models_requested", "failed_count", "measured_input_tokens", "measured_output_tokens", "measured_cost_usd"],
      "properties": {
        "status": { "type": "string", "enum": ["OBSERVED", "SELF_REPORTED", "MIXED", "UNOBSERVED"] },
        "record_count": { "type": "integer", "minimum": 0 },
        "observed_count": { "type": "integer", "minimum": 0 },
        "self_reported_count": { "type": "integer", "minimum": 0 },
        "roles": { "type": "array", "items": { "type": "string" } },
        "tiers": { "type": "array", "items": { "type": "string" } },
        "models_requested": { "type": "array", "items": { "type": "string" } },
        "failed_count": { "type": "integer", "minimum": 0 },
        "measured_input_tokens": { "anyOf": [{ "type": "number", "minimum": 0 }, { "const": "unknown" }] },
        "measured_output_tokens": { "anyOf": [{ "type": "number", "minimum": 0 }, { "const": "unknown" }] },
        "measured_cost_usd": { "anyOf": [{ "type": "number", "minimum": 0 }, { "const": "unknown" }] }
      }
    },
    "failure_reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "impact_analysis_file": { "type": ["string", "null"] },
    "feedback_packet_file": { "type": ["string", "null"] },
    "regression_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "fallback_to_full", "total_checks", "executed_count", "skipped_count", "selected_tests", "unselected_tests"],
      "properties": {
        "mode": { "type": "string", "enum": ["full", "selective", "fallback_to_full"] },
        "fallback_to_full": { "type": "boolean" },
        "fallback_reason": { "type": ["string", "null"] },
        "total_checks": { "type": "integer", "minimum": 0 },
        "executed_count": { "type": "integer", "minimum": 0 },
        "skipped_count": { "type": "integer", "minimum": 0 },
        "selected_tests": { "type": "array", "items": { "type": "string" } },
        "unselected_tests": { "type": "array", "items": { "type": "string" } }
      }
    },
    "human_review": {
      "type": "object",
      "required": ["status", "package_file", "package_sha256"],
      "properties": {
        "status": { "type": "string", "enum": ["PENDING", "READY_FOR_HUMAN_REVIEW", "ACCEPTED", "CHANGES_REQUESTED", "REJECTED", "BLOCKED"] },
        "package_file": { "type": ["string", "null"] },
        "package_sha256": { "type": ["string", "null"] },
        "editorial_report_file": { "type": ["string", "null"] }
      }
    }
  }
}
