{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crafthelm.local/schemas/review-package.schema.json",
  "title": "CraftHelm Human Review Package Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "preset",
    "report_file",
    "report_sha256",
    "target_snapshot_digest",
    "verification_stamp_file",
    "sections_present",
    "broken_links",
    "ac_mismatches",
    "critical_confirmations",
    "generated_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["0.2", "0.3"] },
    "run_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "preset": { "type": "string", "enum": ["executive", "engineering", "handoff"] },
    "report_file": { "type": "string", "minLength": 1 },
    "report_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "target_snapshot_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "verification_stamp_file": { "type": "string", "minLength": 1 },
    "editorial_report_file": { "type": "string" },
    "sections_present": {
      "type": "array",
      "minItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "broken_links": {
      "type": "array",
      "items": { "type": "string" }
    },
    "ac_mismatches": {
      "type": "array",
      "items": { "type": "string" }
    },
    "critical_confirmations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "generated_at": { "type": "string", "minLength": 1 }
  }
}
