{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crafthelm.local/schemas/skill-lock.schema.json",
  "title": "CraftHelm Skill Lockfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "host", "skills"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["0.1", "0.2", "0.3"] },
    "generated_at": { "type": "string", "minLength": 1 },
    "host": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "license",
          "upstream_url",
          "source_path",
          "files_digest",
          "file_hashes",
          "permission_scope",
          "approved_at"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "upstream_url": { "type": "string", "minLength": 1 },
          "source_path": { "type": "string", "minLength": 1 },
          "files_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "file_hashes": {
            "type": "object",
            "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "permission_scope": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "approved_at": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
